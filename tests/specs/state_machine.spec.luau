local TestKit = require("../lib/TestKit")
local Loader = require("../lib/Loader")
local describe, it, expect = TestKit.describe, TestKit.it, TestKit.expect

local SM = Loader.server("Core/MimicStateMachine")

local A, B = 101, 202

describe("MimicStateMachine", function()
	it("démarre déguisé, sans propriétaire", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		expect(r.state).toBe("Disguised")
		expect(r.ownerId).toBeNil()
		expect(r.personal).toBe(false)
		expect(SM.new("T1", "chairy", "TUTO", 0, A).personal).toBe(true)
	end)

	it("suit le chemin nominal jusqu'à la capture", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		expect(SM.reveal(r, A, 1, 8)).toBe(true)
		expect(r.state).toBe("Revealed")
		expect(SM.startCapture(r, A, "A1", 2, 14)).toBe(true)
		expect(r.state).toBe("Capturing")
		expect(SM.completeCapture(r, A, "A1", 5)).toBe(true)
		expect(r.state).toBe("Captured")
	end)

	it("verrouille le Mimic révélé sur le premier joueur", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		SM.reveal(r, A, 1, 8)
		local ok, err = SM.reveal(r, B, 1, 8)
		expect(ok).toBe(false)
		expect(err).toBe("WrongState")
		ok, err = SM.startCapture(r, B, "A9", 2, 14)
		expect(ok).toBe(false)
		expect(err).toBe("NotOwner")
		expect(r.ownerId).toBe(A)
	end)

	it("refuse de capturer un Mimic encore déguisé", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		local ok, err = SM.startCapture(r, A, "A1", 0, 14)
		expect(ok).toBe(false)
		expect(err).toBe("WrongState")
	end)

	it("refuse une révélation expirée", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		SM.reveal(r, A, 0, 8)
		local ok, err = SM.startCapture(r, A, "A1", 9, 14)
		expect(ok).toBe(false)
		expect(err).toBe("Expired")
	end)

	it("refuse de clore une capture avec une autre tentative", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		SM.reveal(r, A, 0, 8)
		SM.startCapture(r, A, "A1", 1, 14)
		local ok, err = SM.completeCapture(r, A, "A2", 2)
		expect(ok).toBe(false)
		expect(err).toBe("AttemptMismatch")
		ok, err = SM.completeCapture(r, B, "A1", 2)
		expect(ok).toBe(false)
		expect(err).toBe("NotOwner")
	end)

	it("ne capture pas deux fois", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		SM.reveal(r, A, 0, 8)
		SM.startCapture(r, A, "A1", 1, 14)
		expect(SM.completeCapture(r, A, "A1", 2)).toBe(true)
		local ok, err = SM.completeCapture(r, A, "A1", 2)
		expect(ok).toBe(false)
		expect(err).toBe("WrongState")
	end)

	it("fait fuir puis recache le Mimic après un échec", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		SM.reveal(r, A, 0, 8)
		SM.startCapture(r, A, "A1", 1, 14)
		expect(SM.failCapture(r, A, "A1", 3, 2)).toBe(true)
		expect(r.state).toBe("Fleeing")
		expect(SM.tick(r, 4, 2)).toBeNil()
		expect(SM.tick(r, 5, 2)).toBe("FleeFinished")
		expect(SM.settle(r, "V03", 5)).toBe(true)
		expect(r.state).toBe("Disguised")
		expect(r.slotId).toBe("V03")
		expect(r.ownerId).toBeNil()
		expect(r.attemptId).toBeNil()
	end)

	it("libère une révélation abandonnée", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		SM.reveal(r, A, 0, 8)
		expect(SM.tick(r, 7.9, 2)).toBeNil()
		expect(SM.tick(r, 8, 2)).toBe("ClaimExpired")
		expect(r.state).toBe("Fleeing")
	end)

	it("signale le délai dépassé d'une capture sans changer d'état", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		SM.reveal(r, A, 0, 8)
		SM.startCapture(r, A, "A1", 1, 14)
		expect(SM.tick(r, 15, 2)).toBe("CaptureTimeout")
		expect(r.state).toBe("Capturing")
	end)

	it("incrémente la révision à chaque transition", function()
		local r = SM.new("M1", "chairy", "V01", 0)
		SM.reveal(r, A, 0, 8)
		SM.startCapture(r, A, "A1", 1, 14)
		expect(r.revision).toBe(2)
	end)
end)
